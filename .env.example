# The cashier backend. No trailing slash. Every path in the client already carries its own /v1.
VITE_API_BASE_URL=http://localhost:3000

# Human name shown in the sidebar and the browser title.
VITE_APP_NAME=Cashier Console

# "true" boots the in-browser MSW mock API instead of calling the backend. Use it for demos, for
# working on the UI with no database, and for the Playwright suite. NEVER set it in production.
VITE_ENABLE_MOCKS=false

# Sends `X-Tenant-Id` with every admin request, so ONE platform-admin login can run every operator
# on the platform. The backend honours it only for PLATFORM_ADMIN and ignores it from anybody else.
#
# Requires a backend that carries the tenant claim: the login code and the access token both carry
# it, and a middleware enters that tenant for every /v1/admin/* request. Against an OLDER backend
# leave this false — the header would be ignored and every screen would quietly show the default
# operator, which is the one failure this flag exists to prevent. See docs/API-CONTRACT.md §5.
VITE_TENANT_HEADER_ENABLED=true
